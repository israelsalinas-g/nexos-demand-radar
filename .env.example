# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Database (direct connection for Prisma migrations) ---
DATABASE_URL=postgresql://postgres:[DB-PASSWORD]@db.ieaclmnolgmwmtgwkeuq.supabase.co:5432/postgres

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- NestJS API ---
API_PORT=3001
API_SECRET=change-me-to-a-random-secret

# --- FastAPI AI worker ---
AI_WORKER_URL=http://localhost:8000

# --- OpenAI (or compatible) ---
OPENAI_API_KEY=sk-your-api-key-here

# --- Alerts: Telegram ---
TELEGRAM_BOT_TOKEN=8832650596:AAEk11eFfgKejboGf3bZwR6MkOWXgMOFdy8
TELEGRAM_CHAT_ID=1437848545

# --- Alerts: Email (Resend or SMTP) ---
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# --- Next.js frontend ---
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_API_URL=http://localhost:3001
