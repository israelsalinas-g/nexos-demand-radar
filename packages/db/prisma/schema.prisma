// Demand Radar – Prisma schema (mirrors Supabase SQL)
// generator client produces the typed DB client used by api/ and workers/

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgTrgm(map: "pg_trgm"), vector]
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships   OrganizationMember[]
  savedSearches SavedSearch[]
  alerts        Alert[]

  @@map("users")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members       OrganizationMember[]
  sources       Source[]
  signals       ExtractedSignal[]
  savedSearches SavedSearch[]
  alerts        Alert[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String   @default("member")
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_members")
}

model Source {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  type           String    // rss | api | scraper | webhook
  url            String?
  config         Json      @default("{}")
  vertical       String?   // autos | real_estate | smartphones | laptops
  status         String    @default("active")
  lastCheckedAt  DateTime? @map("last_checked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        CollectedItem[]

  @@map("sources")
}

model CollectedItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId    String    @map("source_id") @db.Uuid
  externalId  String?   @map("external_id")
  url         String?
  title       String?
  body        String?
  rawPayload  Json      @default("{}") @map("raw_payload")
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  collectedAt DateTime  @default(now()) @map("collected_at") @db.Timestamptz

  source  Source            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  signals ExtractedSignal[]

  @@unique([sourceId, externalId])
  @@map("collected_items")
}

model ExtractedSignal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  category       String?  // autos | real_estate | smartphones | laptops
  intent         String?  // buy | sell | rent | unknown
  score          Decimal? @db.Decimal(4, 2)
  location       String?
  price          Decimal? @db.Decimal(14, 2)
  currency       String?  @default("HNL")
  // embedding stored as Unsupported; use raw queries for vector ops
  metadata       Json     @default("{}")
  extractedAt    DateTime @default(now()) @map("extracted_at") @db.Timestamptz

  item         CollectedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alertRuns    AlertRun[]

  @@map("extracted_signals")
}

model SavedSearch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdBy      String?  @map("created_by") @db.Uuid
  name           String
  keywords       String[] @default([])
  filters        Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  alerts       Alert[]

  @@map("saved_searches")
}

model Alert {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  savedSearchId   String?  @map("saved_search_id") @db.Uuid
  createdBy       String?  @map("created_by") @db.Uuid
  name            String
  channel         String   // email | telegram | webhook
  channelConfig   Json     @default("{}") @map("channel_config")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  savedSearch  SavedSearch? @relation(fields: [savedSearchId], references: [id], onDelete: SetNull)
  creator      User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  runs         AlertRun[]

  @@map("alerts")
}

model AlertRun {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertId   String    @map("alert_id") @db.Uuid
  signalId  String    @map("signal_id") @db.Uuid
  status    String    @default("pending") // pending | sent | failed
  sentAt    DateTime? @map("sent_at") @db.Timestamptz
  error     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  alert  Alert           @relation(fields: [alertId], references: [id], onDelete: Cascade)
  signal ExtractedSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@map("alert_runs")
}
